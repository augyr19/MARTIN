<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>MARTIN_Jetson_Package</name>
  <version>0.1.0</version>
  <description>MARTIN (Mobile Autonomous Remover of Trash In the eNvironment) ROS 2 Humble package for SYBIL (Single-class YOLO Based Identifier of Litter) and RealSense depth camera</description>

  <maintainer email="ullmannb@tamu.edu">ullmannb</maintainer>
  <license>MIT</license>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- ROS 2 core dependencies -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>

  <!-- Python dependencies from requirements.txt -->
  <!-- Note: ROS 2 uses rosdep to resolve these, but they're also in setup.py -->

  <!-- Testing -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

